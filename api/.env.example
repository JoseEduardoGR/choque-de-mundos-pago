FLASK_DEBUG=0
PORT=5055

# Token para listar y confirmar pagos. Genera uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Dominio desde el que se llama a la API. En producción NO dejes *.
CORS_ORIGINS=*

# SQLite por defecto. Para PostgreSQL, descomenta y usa SU PROPIA base,
# nunca la de GR Code:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/ares_pagos

# Tarifas (el servidor es quien calcula el monto)
PRECIO_LOCAL=75
PRECIO_EXTERNA=150
VOLUMEN_DESDE=10
PRECIO_VOLUMEN=100
MAX_ROBOTS=30
